{
  "name": "don-cloudflare-sync-worker",
  "version": "1.0.0",
  "description": "Serverless Cloudflare Worker + D1 + R2 sync service for DON / DonutBrowser",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create don-sync-db",
    "d1:migrate:local": "wrangler d1 execute don-sync-db --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute don-sync-db --remote --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create don-sync-bucket",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.4",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260708.1",
    "typescript": "^5.8.2",
    "wrangler": "4.110.0"
  }
}
